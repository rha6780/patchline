# Copy to .env (same directory) and adjust. Every PATCHLINE_* variable here is
# passed to Patchline; see docs/configuration.md for the full list.

# --- Compose ---

# Image to run. `docker compose up --build` builds it from this repository;
# set a registry image instead to deploy a prebuilt one.
PATCHLINE_IMAGE=patchline:local
# Host address and port of the web UI and webhooks. 127.0.0.1 keeps it local;
# use 0.0.0.0 only behind an authenticating reverse proxy or firewall.
PATCHLINE_BIND=127.0.0.1
PATCHLINE_PORT=8080
# Directory mounted at /etc/patchline: inventory/ and optionally policy.yaml.
PATCHLINE_CONFIG_DIR=./config

# --- Patchline ---

# Shared secret Dependency-Track sends as ?token=... on the webhook URL.
# Generate one with: openssl rand -hex 32
PATCHLINE_WEBHOOK_TOKEN=
# Secret on the Gitea / Forgejo / GitHub pull request webhook.
# Empty = that webhook uses PATCHLINE_WEBHOOK_TOKEN (?token=...) instead.
PATCHLINE_GITEA_WEBHOOK_SECRET=

# Dependency-Track API server, as Patchline reaches it.
# With the dependency-track profile: http://dtrack-apiserver:8080
PATCHLINE_DT_URL=
# API key with VIEW_VULNERABILITY and VIEW_PORTFOLIO (+ VULNERABILITY_ANALYSIS
# to write approved risk acceptances)
PATCHLINE_DT_API_KEY=
# Dependency-Track UI as users reach it, for links in messages
PATCHLINE_DT_UI_URL=
PATCHLINE_DT_RECONCILE_DELAY=2m

# Remediation policy; empty = built-in defaults.
# PATCHLINE_POLICY_PATH=/etc/patchline/policy.yaml
# CISA KEV catalog; "off" disables, or point it at an internal mirror.
# PATCHLINE_KEV_URL=off

# Slack bot token (chat:write, chat:write.public). Empty = print to stdout.
PATCHLINE_SLACK_BOT_TOKEN=
PATCHLINE_SLACK_DEFAULT_CHANNEL=
PATCHLINE_NOTIFY_MIN_SEVERITY=medium
PATCHLINE_NOTIFY_LANG=en

# --- Sign-in (OIDC) and permissions; see docs/access-control.md ---

# Where users reach Patchline; the redirect URI is PATCHLINE_PUBLIC_URL/auth/callback
PATCHLINE_PUBLIC_URL=
# Empty issuer = no sign-in, read-only UI
PATCHLINE_OIDC_ISSUER=
PATCHLINE_OIDC_CLIENT_ID=
PATCHLINE_OIDC_CLIENT_SECRET=
# ID token claim(s) read as groups: groups (Keycloak, Okta), roles (FusionAuth)
PATCHLINE_OIDC_GROUPS_CLAIM=groups
PATCHLINE_SESSION_TTL=12h
# Groups -> permissions; copy ../../examples/access/access-policy.yaml to config/
# PATCHLINE_ACCESS_POLICY_PATH=/etc/patchline/access-policy.yaml

PATCHLINE_LOG_LEVEL=info
PATCHLINE_LOG_FORMAT=text

# --- Dependency-Track (only with --profile dependency-track) ---

# Database password. Generate one with: openssl rand -hex 24
DT_DB_PASSWORD=
DT_BIND=127.0.0.1
DT_API_PORT=8081
DT_UI_PORT=8082
# API URL as the browser reaches it (the frontend calls it directly)
DT_API_BASE_URL=http://localhost:8081

# --- Trivy analyzer (only with --profile trivy) ---

# Token Dependency-Track sends to the Trivy server. Required with the profile;
# an empty token leaves the Trivy server open. openssl rand -hex 32
TRIVY_TOKEN=
TRIVY_VERSION=0.76.1
# Internal OCI mirrors of the Trivy databases (air-gapped servers); empty = public
TRIVY_DB_REPOSITORY=
TRIVY_JAVA_DB_REPOSITORY=
