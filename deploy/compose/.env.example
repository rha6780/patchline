# Copy to .env (same directory) and adjust. All values are optional.

# Host ports
PATCHLINE_PORT=18080

# Shared secret: SBOM uploads (/ingest/sbom) and Dependency-Track's webhook
PATCHLINE_WEBHOOK_TOKEN=change-me

# OSV ecosystems Patchline matches (the samples need Maven and npm; add PyPI,
# Go, ... for your own SBOMs). OS packages go to the demo's Trivy server.
PATCHLINE_OSV_ECOSYSTEMS=Maven,npm
# Token between Patchline (and Dependency-Track) and the demo's Trivy server
# TRIVY_TOKEN=patchline-demo-trivy

# Secret configured on the Gitea / Forgejo / GitHub pull request webhook.
# Empty = the Gitea webhook uses PATCHLINE_WEBHOOK_TOKEN (?token=...) instead.
PATCHLINE_GITEA_WEBHOOK_SECRET=

# Slack bot token (scopes: chat:write, chat:write.public). Empty = print
# notifications to the Patchline log instead.
PATCHLINE_SLACK_BOT_TOKEN=
# Channel for findings whose service has no slack_channel (and unregistered projects)
PATCHLINE_SLACK_DEFAULT_CHANNEL=
# Lowest severity that is posted: critical, high, medium, low, info
PATCHLINE_NOTIFY_MIN_SEVERITY=medium
# Language of Slack and console messages: en or ko
PATCHLINE_NOTIFY_LANG=en

# --- Optional: Dependency-Track (make demo-up PROFILE=dependency-track) ---

DT_API_PORT=18081
DT_UI_PORT=18082
# Database password (local demo only)
DT_DB_PASSWORD=dtrack
# Admin password make demo-seed-dt uses (on first start it changes admin/admin
# to this). Set it if you changed it yourself.
# DT_ADMIN_PASSWORD=patchline-demo
# Written by make demo-seed-dt:
PATCHLINE_DT_API_KEY=
# PATCHLINE_DT_UI_URL=http://localhost:18082
# Wait after a BOM is processed before comparing findings (resolution check)
PATCHLINE_DT_RECONCILE_DELAY=2m

# CISA KEV catalog (refreshed daily); set to "off" to disable
# PATCHLINE_KEV_URL=off
