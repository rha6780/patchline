# Copy to .env (same directory) and adjust. All values are optional.

# Host ports
PATCHLINE_PORT=18080
DT_API_PORT=18081
DT_UI_PORT=18082

# Dependency-Track database password (local demo only)
DT_DB_PASSWORD=dtrack

# Shared secret Dependency-Track sends as ?token=... on the webhook URL
PATCHLINE_WEBHOOK_TOKEN=change-me

# Dependency-Track API key Patchline uses to read findings
# (Administration > Access Management > Teams > Automation > API Keys)
PATCHLINE_DT_API_KEY=

# Wait after a BOM is processed before comparing findings (resolution check)
PATCHLINE_DT_RECONCILE_DELAY=2m

# Slack bot token (scopes: chat:write, chat:write.public). Empty = print
# notifications to the Patchline log instead.
PATCHLINE_SLACK_BOT_TOKEN=
# Channel for findings whose service has no slack_channel (and unregistered projects)
PATCHLINE_SLACK_DEFAULT_CHANNEL=
# Lowest severity that is posted: critical, high, medium, low, info
PATCHLINE_NOTIFY_MIN_SEVERITY=medium
