# Copy to .env (same directory) and adjust. All values are optional.

# Host ports
PATCHLINE_PORT=18080
DT_API_PORT=18081
DT_UI_PORT=18082

# Dependency-Track database password (local demo only)
DT_DB_PASSWORD=dtrack

# Shared secret Dependency-Track sends as ?token=... on the webhook URL
PATCHLINE_WEBHOOK_TOKEN=change-me

# Dependency-Track API key Patchline uses to read findings
# (Administration > Access Management > Teams > Automation > API Keys)
PATCHLINE_DT_API_KEY=
